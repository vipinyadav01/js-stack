{{#if (eq api "graphql")}}
package com.example.app.graphql;

import org.springframework.graphql.data.method.annotation.QueryMapping;
{{#if (eq orm "jpa")}}
import java.util.List;

import org.springframework.graphql.data.method.annotation.Argument;
import org.springframework.graphql.data.method.annotation.MutationMapping;
{{/if}}
import org.springframework.stereotype.Controller;
{{#if (eq orm "jpa")}}

import com.example.app.todo.Todo;
import com.example.app.todo.TodoRepository;
{{/if}}

/**
 * Resolvers for the schema in src/main/resources/graphql/schema.graphqls.
 * Explore them at http://localhost:8080/graphiql while running locally.
 */
@Controller
public class GraphqlController {

    public record Health(String status, String service) {
    }
{{#if (eq orm "jpa")}}

    private final TodoRepository repository;

    public GraphqlController(TodoRepository repository) {
        this.repository = repository;
    }
{{/if}}

    @QueryMapping
    public Health health() {
        return new Health("ok", "{{projectName}}");
    }
{{#if (eq orm "jpa")}}

    @QueryMapping
    public List<Todo> todos() {
        return repository.findAll();
    }

    @QueryMapping
    public Todo todo(@Argument Long id) {
        return repository.findById(id).orElse(null);
    }

    @MutationMapping
    public Todo addTodo(@Argument String title) {
        return repository.save(new Todo(title));
    }

    @MutationMapping
    public Todo toggleTodo(@Argument Long id) {
        return repository.findById(id)
                .map(todo -> {
                    todo.setCompleted(!todo.isCompleted());
                    return repository.save(todo);
                })
                .orElse(null);
    }
{{/if}}
}
{{/if}}
