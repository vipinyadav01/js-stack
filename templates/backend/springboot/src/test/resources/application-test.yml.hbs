{{#if (eq orm "jpa")}}
# Tests run against an in-memory database so `mvn test` needs no running server.
spring:
  datasource:
    url: jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1
    driver-class-name: org.h2.Driver
    username: sa
    password: ""
  jpa:
    hibernate:
      ddl-auto: create-drop
{{/if}}
