{
  "name": "@vipinyadav02/createjsstack",
  "version": "1.3.0",
  "description": "Scaffold production-ready full-stack apps in JavaScript, TypeScript and Java. React, Next.js or Vue with Express, NestJS or Spring Boot, plus Prisma, JPA, auth and Docker.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "web"
  ],
  "main": "dist/index.mjs",
  "bin": {
    "createjsstack": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "npm run build:cli && turbo run build",
    "build:cli": "tsdown src/cli.ts src/index.ts --format esm --clean",
    "build:web": "turbo run build --filter=web",
    "dev": "turbo run dev",
    "dev:cli": "tsx src/cli.ts",
    "dev:web": "turbo run dev --filter=web",
    "type-check": "tsc --noEmit && npm run type-check --workspace=web",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepare": "npx husky install 2>/dev/null || echo 'Husky not required for production'",
    "build:release": "node scripts/build.js",
    "publish:npm": "npm run build:release && npm publish",
    "publish:npm:dry": "npm run build:release && npm publish --dry-run",
    "release:all": "npm run version-packages && npm run build:release && git add . && git commit -m 'chore(release): version packages' && git push origin main",
    "postinstall": "echo 'Installation complete!'"
  },
  "keywords": [
    "cli",
    "scaffolding",
    "generator",
    "create-app",
    "boilerplate",
    "starter",
    "template",
    "fullstack",
    "full-stack",
    "javascript",
    "typescript",
    "java",
    "spring-boot",
    "react",
    "nextjs",
    "vue",
    "express",
    "nestjs",
    "hono",
    "prisma",
    "drizzle",
    "jpa",
    "mern",
    "monorepo",
    "docker"
  ],
  "author": "Vipin Yadav",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vipinyadav01/js-stack.git"
  },
  "bugs": {
    "url": "https://github.com/vipinyadav01/js-stack/issues"
  },
  "homepage": "https://createjsstack.dev",
  "dependencies": {
    "@biomejs/biome": "^1.8.0",
    "@clack/prompts": "^0.7.0",
    "boxen": "^7.1.1",
    "chalk": "^4.1.2",
    "chalk-animation": "^2.0.3",
    "cli-progress": "^3.12.0",
    "cli-spinners": "^2.9.2",
    "cli-table3": "^0.6.3",
    "commander": "^11.1.0",
    "execa": "^8.0.1",
    "figlet": "^1.7.0",
    "fs-extra": "^11.2.0",
    "globby": "^13.2.2",
    "gradient-string": "^2.0.2",
    "handlebars": "^4.7.8",
    "inquirer": "^12.9.6",
    "nanospinner": "^1.2.2",
    "ora": "^7.0.1",
    "posthog-node": "^5.17.4",
    "terminal-link": "^2.1.1",
    "tinyglobby": "^0.2.9",
    "tsdown": "^0.22.14",
    "validate-npm-package-name": "^5.0.1",
    "yup": "^1.4.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.4.8",
    "@changesets/cli": "^2.27.1",
    "@types/fs-extra": "^11.0.4",
    "@types/handlebars": "^4.1.0",
    "@types/node": "^20.10.0",
    "@types/validate-npm-package-name": "^4.0.2",
    "esbuild": "^0.27.2",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.0",
    "tsx": "^4.7.0",
    "turbo": "^2.10.11",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,mdx,json,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
